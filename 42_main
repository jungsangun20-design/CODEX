  .dg-about-began__media{ max-width:420px; }
}


/* ════════ SECTION 3 · BRAIN WELLNESS FIRST ════════ */
.dg-brain-first{ width:100%; background:#fff; color:#000; font-family:var(--dg-font-body); }
.dg-brain-first, .dg-brain-first *{ box-sizing:border-box; }
.dg-brain-first__inner{ max-width:1440px; margin:0 auto; padding:clamp(34px,5.2vw,74px) clamp(24px,5vw,72px) clamp(44px,6vw,86px); display:grid; grid-template-columns:minmax(220px,.78fr) minmax(0,1.22fr); align-items:start; column-gap:clamp(38px,6.4vw,92px); }
.dg-brain-first__media{ width:100%; line-height:0; }
.dg-brain-first__img{ display:block; width:100%; height:auto; object-fit:cover; }
.dg-brain-first__content{ padding-top:clamp(24px,3vw,44px); }
.dg-brain-first__title{ margin:0; color:#000; font-family:var(--dg-font-body); font-size:clamp(46px,5.5vw,78px); font-weight:400; line-height:1.1; letter-spacing:-.075em; word-break:keep-all; }
.dg-brain-first__copy{ margin:clamp(36px,4vw,54px) 0 0; max-width:720px; color:#000; font-family:var(--dg-font-body); font-size:clamp(14px,1.25vw,16px); font-weight:400; line-height:1.42; letter-spacing:-.045em; word-break:keep-all; }
.dg-brain-first__copy p{ margin:0; }
