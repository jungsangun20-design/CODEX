.dg-hero, .dg-hero *{ box-sizing:border-box; }
.dg-hero__media{ position:relative; width:100%; line-height:0; overflow:hidden; }
.dg-hero__img{ display:block; width:100%; height:auto; }
.dg-hero__overlay{ position:absolute; left:50%; bottom:12%; transform:translateX(-50%);
  width:100%; padding-inline:var(--dg-gutter); line-height:1.5;
  display:flex; flex-direction:column; align-items:center; text-align:center;
  gap:clamp(18px,2.6vw,32px); }
.dg-hero__copy{ margin:0; color:#fff; font-family:var(--dg-font-display); font-weight:500;
  font-size:clamp(.95rem,1.8vw,1.35rem); line-height:1.5; text-shadow:0 1px 16px rgba(0,0,0,.28); word-break:keep-all; }
.dg-hero__copy, .dg-hero__cta{ opacity:0; transform:translateY(16px); animation:dgHeroUp .9s ease forwards; }
.dg-hero__copy{ animation-delay:.15s; }
.dg-hero__cta{  animation-delay:.38s; }
@keyframes dgHeroUp{ to{ opacity:1; transform:none; } }
@media (min-width:768px){
  .dg-hero__media { height: clamp(480px, 42vw, 680px); }
  .dg-hero__img { height: 100%; object-fit: cover; object-position: center; }
  .dg-hero__overlay { bottom: 12%; }
}
@media (max-width:767px){
  .dg-hero__media { height: 100vh; height: 100dvh; }
  .dg-hero__img { height: 100%; object-fit: cover; object-position: center; }
  .dg-hero__overlay { bottom: 15%; gap:22px; padding-inline:24px; width:100%; }
  .dg-hero__copy { font-size:1.05rem; line-height:1.55; max-width:280px; margin:0 auto; }
  .dg-hero__cta { width:100%; max-width:280px; padding:1.15em 0; font-size:1rem; }
}

/* ════════ SECTION 2 · THE RITUAL OF MIND ════════ */
.dg-ritual{ font-family:var(--dg-font-body); padding-top:clamp(56px,9vw,120px); }
.dg-ritual, .dg-ritual *{ box-sizing:border-box; }
.dg-ritual__inner{ max-width:var(--dg-maxw); margin:0 auto; padding-inline:var(--dg-gutter); }
.dg-ritual__head{ display:grid; grid-template-columns:1fr; gap:1.4rem; align-items:start; }
.dg-ritual__eyebrow{ margin:0; font-weight:700; font-size:.72rem; letter-spacing:.16em;
  text-transform:uppercase; color:var(--dg-ink); }
.dg-ritual__title{ margin:0; color:var(--dg-ink); font-family:var(--dg-font-display);
  font-weight:400; line-height:1.04; letter-spacing:-.02em; font-size:clamp(2.6rem,9vw,5.5rem); text-align:left; }
.dg-ritual__lead{ margin:1.3rem 0 0; color:var(--dg-ink-soft); text-align:left;
  font-size:clamp(.85rem,1.4vw,1rem); line-height:1.75; max-width:52ch; }
.dg-ritual__rule{ border:0; border-top:1px solid var(--dg-line); margin:clamp(26px,4vw,46px) 0 0; }
.dg-ritual__media{ width:100%; aspect-ratio:40/9; overflow:hidden;
  margin-top:clamp(26px,4vw,50px); line-height:0; }
.dg-ritual__img{ display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
@media (min-width:768px){ .dg-ritual__head{ grid-template-columns:1fr 1.5fr; gap:2rem; } }

/* ════════ SECTION 3 · WE BELIEVE ════════ */
.dg-belief{ font-family:var(--dg-font-body); padding-block:clamp(52px,8vw,110px); }
.dg-belief, .dg-belief *{ box-sizing:border-box; }
.dg-belief__inner{ max-width:var(--dg-maxw); margin:0 auto; padding-inline:var(--dg-gutter);
  display:grid; grid-template-columns:1fr; gap:clamp(30px,5vw,56px); align-items:start; }
.dg-belief__title{ margin:0; color:var(--dg-ink); font-family:var(--dg-font-display);
  font-weight:500; line-height:1.12; letter-spacing:-.02em; font-size:clamp(1.7rem,4.6vw,3rem); }
.dg-belief__body{ margin:1.6rem 0 0 12%; color:var(--dg-ink-soft);
  font-size:clamp(.85rem,1.4vw,1rem); line-height:1.75; max-width:46ch; }
.dg-belief__media{ line-height:0; }
.dg-belief__img{ display:block; width:100%; height:auto; }
@media (min-width:768px){
  .dg-belief__inner{ grid-template-columns:1fr 1fr; gap:clamp(28px,4vw,56px); }
  .dg-belief__body{ margin-left:30%; }
}

/* ════════ SECTION 4 · JOIN ════════ */
.dg-join{ width:100%; font-family:var(--dg-font-body); }
.dg-join, .dg-join *{ box-sizing:border-box; }
.dg-join__inner{ display:grid; grid-template-columns:1fr; }
.dg-join__text{ display:flex; flex-direction:column; justify-content:center;
  padding:clamp(48px,8vw,110px) var(--dg-gutter); }
.dg-join__textinner{ width:100%; max-width:480px; }
.dg-join__intro{ margin:0; color:var(--dg-ink-soft); font-size:clamp(.82rem,1.3vw,.95rem); line-height:1.7; }
.dg-join__title{ margin:1.4rem 0 1.9rem; color:var(--dg-ink); font-family:var(--dg-font-display);
  font-weight:600; line-height:1.32; letter-spacing:-.01em; font-size:clamp(1.45rem,3.6vw,2.2rem); }
.dg-join__cta{ display:flex; flex-direction:column; gap:.7rem; }
.dg-join__media{ line-height:0; }
.dg-join__img{ display:block; width:100%; height:auto; }
@media (min-width:768px){
  .dg-join__inner{ grid-template-columns:1fr 1fr; align-items:stretch; }
  .dg-join__media{ position:relative; }
  .dg-join__img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
}

/* ════════ SECTION 5 · FORMULA ════════ */
.dg-formula{ font-family:var(--dg-font-body); padding-block:clamp(56px,8vw,120px); }
.dg-formula, .dg-formula *{ box-sizing:border-box; }
.dg-formula__inner{ max-width:var(--dg-maxw); margin:0 auto; padding-inline:var(--dg-gutter); }
.dg-formula__head{ margin-bottom:clamp(24px,4vw,32px); text-align:left; }
.dg-formula__title{ margin:0; font-family:var(--dg-font-display); font-weight:400;
  font-size:clamp(1.8rem,4.5vw,2.8rem); letter-spacing:-.03em; color:var(--dg-ink); }
.dg-formula__desc{ margin:8px 0 0; color:var(--dg-ink); font-size:clamp(.9rem,1.3vw,1rem); }
.dg-formula__track{ display:flex; flex-direction:column; gap:32px; }
.dg-formula__card{ display:flex; flex-direction:column; }
.dg-formula__media{ width:100%; aspect-ratio:4/3; border-radius:clamp(16px,3vw,28px);
  overflow:hidden; margin-bottom:16px; }
.dg-formula__img{ display:block; width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
.dg-formula__card:hover .dg-formula__img{ transform:scale(1.03); }
.dg-formula__text{ background:#f2f4f5; padding:clamp(20px,3vw,28px); flex-grow:1;
  display:flex; flex-direction:column; border-top:3px solid #e7e9e7; }
.dg-formula__name{ margin:0 0 14px; font-size:clamp(.95rem,1.2vw,1.05rem);
  font-weight:700; color:var(--dg-ink); letter-spacing:-.01em; }
.dg-formula__list{ margin:0; padding:0; list-style:none; }
.dg-formula__item{ position:relative; padding-left:14px; font-size:clamp(.82rem,1.1vw,.92rem);
  line-height:1.6; color:var(--dg-ink); margin-bottom:6px; word-break:keep-all; }
.dg-formula__item::before{ content:"•"; position:absolute; left:0; top:0; color:var(--dg-ink); }
.dg-formula__note{ margin:24px 0 0; font-size:clamp(.82rem,1.1vw,.92rem); line-height:1.6;
  color:var(--dg-ink-soft); word-break:keep-all; }
@media (min-width:768px){
  .dg-formula__track{ flex-direction:row; overflow-x:auto; scroll-snap-type:x mandatory;
    padding-bottom:20px; gap:24px; -webkit-overflow-scrolling:touch; }
  .dg-formula__track::-webkit-scrollbar{ height:6px; }
  .dg-formula__track::-webkit-scrollbar-track{ background:#f1f1f1; border-radius:4px; }
  .dg-formula__track::-webkit-scrollbar-thumb{ background:var(--dg-line); border-radius:4px; }
  .dg-formula__track::-webkit-scrollbar-thumb:hover{ background:var(--dg-ink-soft); }
  .dg-formula__card{ flex:0 0 calc(31.5%); scroll-snap-align:start; }
}

/* ════════ SECTION 6 · REVIEW ════════ */
.dg-review{ font-family:var(--dg-font-body); padding-block:clamp(56px,8vw,120px); background:#ffffff; }
.dg-review, .dg-review *{ box-sizing:border-box; }
.dg-review__inner{ max-width:var(--dg-maxw); margin:0 auto; padding-inline:var(--dg-gutter); }
.dg-review__head{ margin-bottom:clamp(32px,5vw,50px); text-align:left; }
.dg-review__title{ margin:0 0 12px; font-family:var(--dg-font-display); font-weight:400;
  font-size:clamp(2rem,5vw,3rem); letter-spacing:-.03em; color:var(--dg-ink); }
.dg-review__desc{ margin:0; font-size:clamp(.95rem,1.3vw,1.1rem); line-height:1.5; color:var(--dg-ink); }
.dg-review__grid{ display:grid; grid-template-columns:1fr; gap:clamp(16px,2vw,24px); }
@media (min-width:768px){ .dg-review__grid{ grid-template-columns:repeat(3, 1fr); } }
.dg-review__card{ background:#ffffff; border:1px solid var(--dg-ink); border-radius:clamp(20px,3vw,28px);
  padding:clamp(28px,3.5vw,36px); display:flex; flex-direction:column; justify-content:space-between;
  transition:opacity 0.8s cubic-bezier(0.25,0.46,0.45,0.94), transform 0.8s cubic-bezier(0.25,0.46,0.45,0.94); }
/* JS 동작 시에만 숨겼다가 스크롤로 등장 (JS 실패/비활성 시 그냥 보임) */
html.dg-js .dg-review__card{ opacity:0; transform:translateY(40px); }
html.dg-js .dg-review__card.is-visible{ opacity:1; transform:none; }
.dg-review__card:nth-child(2){ transition-delay:0.15s; }
.dg-review__card:nth-child(3){ transition-delay:0.3s; }
.dg-review__text{ margin:0 0 36px; color:var(--dg-ink); font-size:clamp(1rem,1.15vw,1.1rem);
  line-height:1.7; word-break:keep-all; }
.dg-review__footer{ display:flex; justify-content:space-between; align-items:center;
  padding-top:20px; border-top:1px solid var(--dg-line); }
.dg-review__author{ margin:0; color:var(--dg-ink); font-size:clamp(.85rem,1vw,.95rem); font-weight:700; }
.dg-review__stars{ color:var(--dg-ink); font-size:clamp(.9rem,1vw,.95rem); letter-spacing:1px; }

/* ════════ SECTION 7 · ORIGINS ════════ */
.dg-origins{ font-family:var(--dg-font-body); padding-block:clamp(40px,6vw,80px); background:#ffffff; }
.dg-origins, .dg-origins *{ box-sizing:border-box; }
.dg-origins__inner{ max-width:var(--dg-maxw); margin:0 auto; padding-inline:var(--dg-gutter); }
.dg-origins__media{ width:100%; margin-bottom:clamp(20px,3vw,30px); line-height:0; }
.dg-origins__img{ display:block; width:100%; height:auto; }
.dg-origins__title{ margin:0 0 clamp(16px,2vw,24px); font-family:var(--dg-font-display);
  font-weight:600; font-size:clamp(1.1rem, 1.4vw, 1.25rem); color:var(--dg-ink); line-height:1.4; }
.dg-origins__copy{ margin:0 0 clamp(40px,6vw,60px); color:var(--dg-ink); font-family:var(--dg-font-body);
  font-weight:400; font-size:clamp(1.4rem,2.6vw,2.1rem); line-height:1.45; letter-spacing:-.03em; word-break:keep-all; }
.dg-origins__rule{ border:0; border-top:1px solid var(--dg-line); margin:0; }
@media (max-width:767px){ .dg-pc-br{ display:none; } .dg-origins__copy{ font-size:1.25rem; } }

/* ════════ SECTION 8 · TOP ARTICLES ════════ */
.dg-articles{ font-family:var(--dg-font-body); padding-block:clamp(56px,8vw,120px); background:#ffffff; }
.dg-articles, .dg-articles *{ box-sizing:border-box; }
.dg-articles__inner{ max-width:var(--dg-maxw); margin:0 auto; padding-inline:var(--dg-gutter);
  display:grid; grid-template-columns:1fr; gap:clamp(32px,5vw,40px); align-items:start; }
.dg-articles__head{ margin:0; }
.dg-articles__title{ margin:0; font-family:var(--dg-font-display); font-weight:400;
  font-size:clamp(2.4rem,6vw,3.2rem); letter-spacing:-.04em; color:var(--dg-ink); }
.dg-articles__grid{ display:grid; grid-template-columns:1fr; gap:clamp(40px,6vw,56px); }
.dg-article{ display:flex; flex-direction:column; }
.dg-article__media{ width:100%; aspect-ratio:1/1; overflow:hidden; margin-bottom:16px; background:#fff; }
.dg-article__img{ display:block; width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
.dg-article:hover .dg-article__img{ transform:scale(1.03); }
.dg-article__text{ display:flex; flex-direction:column; border-top:1px solid var(--dg-line); padding-top:16px; }
.dg-article__name{ margin:0 0 12px; font-family:var(--dg-font-display); font-size:clamp(1.05rem,1.4vw,1.15rem);
  font-weight:700; color:var(--dg-ink); letter-spacing:-.02em; line-height:1.4; }
.dg-article__desc{ margin:0; font-size:clamp(.85rem,1.1vw,.95rem); line-height:1.65; color:var(--dg-ink); word-break:keep-all; }
@media (min-width:768px){
  .dg-articles__inner{ grid-template-columns:1fr 2.1fr; gap:clamp(40px,6vw,64px); }
  .dg-articles__grid{ grid-template-columns:1fr 1fr; gap:clamp(24px,3vw,40px); }
}

/* ════════ SECTION 9 · FAQ ════════ */
.fd-faq-section { padding: 100px 20px; background-color: #ffffff; }
.fd-container { max-width: var(--dg-maxw); margin: 0 auto; }        /* [추가] 다른 섹션과 폭 정렬 */
.fd-faq-unified-card { display: flex; background-color: #f0efef; border-radius: 40px; overflow: hidden; align-items: stretch; width: 100%; box-sizing: border-box; }
.fd-faq-content-area { flex: 6; padding: 70px 60px; display: flex; flex-direction: column; justify-content: center; }
.fd-faq-title { font-family: var(--dg-font-body); font-size: 48px; font-weight: 700; color: #000000; margin: 0 0 35px; letter-spacing: -0.04em; }
.fd-faq-item { border-bottom: 1px solid rgba(0,0,0,.1); }            /* [수정] 흰색→어두운 색 (회색 배경에서 보이게) */
.fd-faq-item:last-child { border-bottom: none; }
.fd-faq-question { font-family: var(--dg-font-body); width:100%; background:none; border:0; -webkit-appearance:none; appearance:none; text-align:left;
  display: flex; justify-content: space-between; align-items: center; padding: 18px 0; font-size: 18px; font-weight: 600; color: #000000; cursor: pointer; user-select: none; }
.fd-faq-icon { font-size: 24px; font-weight: 300; color: #000000; margin-left: 20px; transition: transform 0.3s ease; display: inline-block; }
.fd-faq-item.active .fd-faq-icon { transform: rotate(45deg); }
.fd-faq-answer { max-height: 0; overflow: hidden; font-size: 18px; line-height: 1.6; color: #000000; word-break: keep-all;
  font-family: var(--dg-font-body); font-weight: 400; transition: max-height 0.4s ease, padding 0.4s ease; padding: 0; }
.fd-faq-item.active .fd-faq-answer { max-height: 500px; padding: 0 0 20px; }
.fd-faq-item.active .fd-faq-question { padding-bottom: 12px; }
.fd-faq-image-area { flex: 4; position: relative; background-color: #ffffff; overflow: hidden; }
.fd-faq-image-area img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
@media (max-width: 768px) {
  .fd-faq-section { padding: 60px 20px; }
  .fd-faq-unified-card { flex-direction: column; border-radius: 30px; }
  .fd-faq-content-area { order: 2; padding: 50px 30px; }
  .fd-faq-title { font-size: 34px; margin-bottom: 25px; }
  .fd-faq-question { font-size: 16px; padding: 16px 0; }
  .fd-faq-answer { font-size: 16px; }
  .fd-faq-image-area { order: 1; flex: none; height: 350px; width: 100%; }
  .fd-faq-image-area img { position: relative; height: 100%; }
}


/* ════════ SECTION 1 · STORY HERO (Cafe24 custom) ════════ */
.dg-story-hero{ width:100%; background:#fff; color:#000; font-family:var(--dg-font-body); overflow:hidden; }
.dg-story-hero, .dg-story-hero *{ box-sizing:border-box; }
.dg-story-hero__inner{ min-height:clamp(390px,43vw,520px); max-width:1440px; margin:0 auto; padding:clamp(44px,7vw,96px) clamp(24px,5vw,72px) clamp(22px,3vw,44px); display:grid; grid-template-columns:minmax(260px,.82fr) minmax(320px,1.18fr); align-items:end; column-gap:clamp(34px,6vw,96px); }
.dg-story-hero__content{ padding-bottom:clamp(0px,1.2vw,18px); }
.dg-story-hero__eyebrow{ margin:0 0 4px; font-family:var(--dg-font-body); font-size:clamp(12px,1.2vw,14px); font-weight:400; line-height:1.35; letter-spacing:-.02em; color:#000; }
.dg-story-hero__title{ margin:0; font-family:var(--dg-font-body); font-size:clamp(58px,7.7vw,112px); font-weight:400; line-height:.96; letter-spacing:-.075em; color:#000; }
.dg-story-hero__actions{ display:flex; flex-wrap:wrap; gap:6px; margin-top:clamp(22px,2.2vw,30px); }
.dg-story-hero__btn{ display:inline-flex; align-items:center; justify-content:center; min-height:23px; padding:5px 20px 6px; border:0; border-radius:999px; background:#000; color:#fff; font-family:var(--dg-font-body); font-size:12px; font-weight:400; line-height:1; letter-spacing:-.02em; text-decoration:none; transition:opacity .25s ease, transform .25s ease; }
.dg-story-hero__btn:hover{ opacity:.82; transform:translateY(-1px); color:#fff; }
.dg-story-hero__mark-wrap{ display:flex; justify-content:center; align-items:center; line-height:0; }
.dg-story-hero__mark{ display:block; width:min(48vw,470px); max-width:100%; height:auto; object-fit:contain; }
@media (max-width:767px){
  .dg-story-hero__inner{ min-height:auto; padding:64px 24px 34px; grid-template-columns:1fr; align-items:start; gap:34px; }
  .dg-story-hero__content{ order:2; padding-bottom:0; }
  .dg-story-hero__mark-wrap{ order:1; justify-content:center; }
  .dg-story-hero__mark{ width:min(76vw,330px); }
  .dg-story-hero__title{ font-size:clamp(48px,16vw,68px); letter-spacing:-.07em; }
}


/* ════════ SECTION 2 · HOW IT ALL BEGAN ════════ */
.dg-about-began{ width:100%; background:#fff; color:#000; font-family:var(--dg-font-body); }
.dg-about-began, .dg-about-began *{ box-sizing:border-box; }
.dg-about-began__inner{ max-width:1440px; margin:0 auto; padding:clamp(34px,5.2vw,74px) clamp(24px,5vw,72px) clamp(44px,6vw,86px); display:grid; grid-template-columns:minmax(0,1.42fr) minmax(220px,.58fr); align-items:start; column-gap:clamp(38px,7vw,96px); }
.dg-about-began__title{ margin:0; color:#000; font-family:var(--dg-font-body); font-size:clamp(48px,6vw,86px); font-weight:400; line-height:.97; letter-spacing:-.075em; word-break:keep-all; }
.dg-about-began__copy{ margin:clamp(42px,4.8vw,66px) 0 0; max-width:700px; color:#000; font-family:var(--dg-font-body); font-size:clamp(14px,1.25vw,16px); font-weight:400; line-height:1.42; letter-spacing:-.045em; word-break:keep-all; }
.dg-about-began__copy p{ margin:0; }
.dg-about-began__copy p + p{ margin-top:clamp(20px,2.2vw,28px); }
.dg-about-began__media{ width:100%; line-height:0; }
.dg-about-began__img{ display:block; width:100%; height:auto; object-fit:cover; }
@media (max-width:767px){
