document.addEventListener("DOMContentLoaded", function() {
  // 1. 카페24 GNB 스크롤 투명화 (의도된 동작 — 유지)
  const headerElement = document.querySelector('#header') || document.querySelector('.xans-layout-header') || document.querySelector('header');
  if (headerElement) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) headerElement.classList.add('dg-header-scrolled');
      else headerElement.classList.remove('dg-header-scrolled');
    });
  }

  // 2. 리뷰 카드 스크롤 등장 (Section 6)
  const reviewObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); reviewObserver.unobserve(entry.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.dg-review__card').forEach(card => reviewObserver.observe(card));

  // 3. FAQ 아코디언 (+ aria-expanded 상태 토글)
  const faqSec = document.getElementById('fdFaqSec');
  if (faqSec) {
    const faqItems = faqSec.querySelectorAll('.fd-faq-item');
    faqItems.forEach(item => {
      const question = item.querySelector('.fd-faq-question');
      const answer = item.querySelector('.fd-faq-answer');
      question.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        faqItems.forEach(o => {
          o.classList.remove('active');
          o.querySelector('.fd-faq-answer').style.maxHeight = '0';
          o.querySelector('.fd-faq-question').setAttribute('aria-expanded', 'false');
        });
        if (!isActive) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          question.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
});
</script></div>
