<style>
	@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.css');

	[class^="dg-"],
	[class*=" dg-"] {
		box-sizing: border-box;
	}

	[class^="dg-"] *,
	[class*=" dg-"] * {
		box-sizing: inherit;
	}

.dg-switch {
		--ink: #161413; --soft: #6b6f6d; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(40px, 7vw, 90px);
	}
.dg-switch__inner {
		max-width: 1200px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px); display: grid; grid-template-columns: 1fr; gap: clamp(28px, 5vw, 52px); align-items: start;
	}
	
	.dg-switch__quote {
		margin: 0; font-weight: 600; line-height: 1.35; letter-spacing: -.02em; font-size: clamp(1.5rem, 3.6vw, 2.5rem); word-break: keep-all;
	}
	
	.dg-switch__attr {
		margin: 14px 0 0; font-weight: 500; line-height: 1.45; font-size: clamp(1rem, 1.8vw, 1.35rem); word-break: keep-all;
	}
	
	.dg-switch__plus {
		width: 30px; height: 30px; margin: clamp(28px, 4vw, 46px) 0 14px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ink); color: #fff; font-size: 18px; font-weight: 400; line-height: 1;
	}
	
	.dg-switch__body {
		margin: 0; color: var(--soft); font-size: clamp(.8rem, 1.1vw, .9rem); line-height: 1.65; max-width: 42ch; word-break: keep-all;
	}
	
	.dg-switch__media {
		line-height: 0;
	}
	
	.dg-switch__img {
		display: block; width: 100%; height: auto; border-radius: clamp(16px, 2.5vw, 24px);
	}
	
	@media (min-width:768px) {
		.dg-switch__inner {
			grid-template-columns: 1.05fr 1fr; gap: clamp(40px, 5vw, 72px); align-items: center;
		}
	} .dg-alt {
		--ink: #161413; --soft: #6b6f6d; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(36px, 6vw, 80px);
	}
.dg-alt__grid {
		max-width: 1200px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px); display: grid; gap: 0; grid-template-areas: "heading" "boxes" "features" "orange"; background-color: #fff;
	}
	
	.dg-alt__boxes {
		grid-area: boxes;
	}
	
	.dg-alt__features {
		grid-area: features;
	}
	
	.dg-alt__heading {
		grid-area: heading;
	}
	
	.dg-alt__orange {
		grid-area: orange;
	}
	/* 이미지 셀 */
	
	.dg-alt__boxes,
	.dg-alt__orange {
		aspect-ratio: 4 / 3; overflow: hidden; line-height: 0; border-radius: 0;
	}
	
	.dg-alt__boxes img,
	.dg-alt__orange img {
		display: block !important; width: 100% !important; max-width: none !important; height: 100% !important; object-fit: cover !important; image-rendering: auto !important;
	}
	/* 헤딩 */
	
	.dg-alt__heading {
		display: flex; align-items: center; min-height: clamp(140px, 24vw, 220px); padding: clamp(24px, 4vw, 40px) clamp(18px, 3vw, 32px); background-color: #fff;
	}
	
	.dg-alt__heading h2 {
		margin: 0; font-weight: 600; line-height: 1.3; letter-spacing: -.02em; font-size: clamp(1.5rem, 3.4vw, 2.3rem); word-break: keep-all;
	}
	/* 피처 리스트 */
	
	.dg-alt__features {
		list-style: none; margin: 0; padding: clamp(32px, 5vw, 64px) clamp(20px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center; gap: clamp(16px, 2.2vw, 22px); background-color: #fff;
	}
	
	.dg-alt__feat {
		display: flex; gap: 10px;
	}
	
	.dg-alt__ico {
		flex: 0 0 auto; width: 22px; height: 22px; margin-top: 2px; border-radius: 50%; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; line-height: 1;
	}
	
	.dg-alt__t {
		margin: 0 0 5px; font-weight: 700; font-size: clamp(.95rem, 1.4vw, 1.05rem); word-break: keep-all;
	}
	
	.dg-alt__d {
		margin: 0; color: var(--soft); font-size: clamp(.8rem, 1.1vw, .9rem); line-height: 1.6; word-break: keep-all;
	}
	
	@media (min-width:768px) {
		.dg-alt__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); grid-template-rows: clamp(360px, 40vw, 470px) clamp(140px, 16vw, 180px); align-items: stretch; grid-template-areas: "boxes features" "heading orange";
		}
		.dg-alt__boxes,
		.dg-alt__orange {
			aspect-ratio: auto; min-height: 0;
		}
		.dg-alt__heading {
			min-height: 0;
		}
	} .dg-rec {
		--ink: #161413; --soft: #9a9d9b; --teal: #16b1a3; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(36px, 6vw, 80px);
	}
.dg-rec__inner {
		max-width: 1200px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px); display: grid; grid-template-columns: 1fr; gap: clamp(28px, 5vw, 48px); align-items: center;
	}
	
	.dg-rec__media {
		line-height: 0;
	}
	
	.dg-rec__media img {
		display: block; width: 100%; height: auto;
	}
	
	.dg-rec__title {
		margin: 0; font-weight: 700; line-height: 1.32; letter-spacing: -.02em; font-size: clamp(1.6rem, 3.8vw, 2.4rem); word-break: keep-all;
	}
	
	.dg-rec__sub {
		margin: clamp(16px, 2.4vw, 24px) 0 0; font-weight: 700; line-height: 1.4; font-size: clamp(1.05rem, 1.8vw, 1.3rem); word-break: keep-all;
	}
	
	.dg-rec__lead {
		margin: 10px 0 0; color: var(--soft); font-size: clamp(.85rem, 1.2vw, .95rem); line-height: 1.6; word-break: keep-all;
	}
	
	.dg-rec__list {
		list-style: none; margin: clamp(20px, 3vw, 30px) 0 0; padding: 0; display: flex; flex-direction: column; gap: clamp(10px, 1.4vw, 14px);
	}
	
	.dg-rec__list li {
		display: flex; align-items: flex-start; gap: 10px; color: #33403d; font-size: clamp(.85rem, 1.2vw, .95rem); line-height: 1.45; word-break: keep-all;
	}
	
	.dg-rec__list strong {
		font-weight: 700; color: var(--ink);
	}
	
	.dg-rec__chk {
		flex: 0 0 auto; width: 20px; height: 20px; margin-top: 1px; border-radius: 50%; background: var(--teal); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; line-height: 1;
	}
	
	@media (min-width:768px) {
		.dg-rec__inner {
			grid-template-columns: .92fr 1fr; gap: clamp(36px, 5vw, 64px);
		}
	} .dg-enjoy {
		--ink: #161413; --soft: #6b6f6d; --bg-sec: #ffffff; background-color: var(--bg-sec); font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(50px, 8vw, 100px);
	}
.dg-enjoy__inner {
		max-width: 1200px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px);
	}
	
	.dg-enjoy__header {
		display: flex; flex-direction: column; gap: 24px; margin-bottom: clamp(32px, 6vw, 60px);
	}
	
	.dg-enjoy__title {
		margin: 0; font-size: clamp(1.8rem, 3.8vw, 2.6rem); font-weight: 700; line-height: 1.25; letter-spacing: -0.04em; word-break: keep-all;
	}
	
	.dg-enjoy__list {
		margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px;
	}
	
	.dg-enjoy__list li {
		position: relative; padding-left: 14px; font-size: clamp(0.95rem, 1.4vw, 1.1rem); font-weight: 500; color: var(--soft); letter-spacing: -0.02em;
	}
	
	.dg-enjoy__list li::before {
		content: ""; position: absolute; left: 0; top: 0.55em; width: 4px; height: 4px; border-radius: 50%; background-color: var(--soft);
	}
	
	.dg-enjoy__grid {
		display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(12px, 2vw, 24px);
	}
	
	.dg-enjoy__item {
		border-radius: clamp(16px, 2.5vw, 24px); overflow: hidden; background-color: #fff; aspect-ratio: 3 / 4;
	}
	
	.dg-enjoy__item img {
		display: block !important; width: 100% !important; max-width: none !important; height: 100% !important; object-fit: cover !important;
	}
	
	.dg-enjoy__item--salad img {
		transform: scale(1.18) !important; transform-origin: center !important;
	}

	@media (min-width: 768px) {
		.dg-enjoy__header {
			flex-direction: row; align-items: flex-end; gap: 48px;
		}
		.dg-enjoy__title {
			flex: 0 0 auto;
		}
