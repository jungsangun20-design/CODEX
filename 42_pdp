	.dg-formula__title {
		margin: 0; font-size: clamp(2.2rem, 4.5vw, 3.2rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;
	}
	
	.dg-formula__title-serif {
		font-family: "Georgia Pro", Georgia, "Times New Roman", serif; font-style: italic; font-weight: 400;
	}
	
	.dg-formula__grid {
		display: flex; flex-direction: column; gap: clamp(32px, 5vw, 40px);
	}
	
	.dg-formula__col {
		display: flex; flex-direction: column; gap: clamp(32px, 5vw, 40px);
	}
	
	.dg-formula__card {
		display: flex; flex-direction: column;
	}
	
	.dg-formula__card--overlay {
		position: relative; isolation: isolate; overflow: hidden; border-radius: clamp(16px, 2.5vw, 24px); aspect-ratio: 1 / 1.15; min-height: clamp(420px, 48vw, 620px); padding: clamp(24px, 4vw, 36px); justify-content: flex-end; color: #fff; background-color: #161413;
	}
	
	.dg-formula__card--overlay img {
		position: absolute !important; inset: 0 !important; display: block !important; width: 100% !important; max-width: none !important; height: 100% !important; object-fit: cover !important; z-index: 1;
	}
	
	.dg-formula__card--overlay .dg-formula__text {
		position: relative; z-index: 2;
	}
	
	.dg-formula__card--stacked .dg-formula__media {
		aspect-ratio: 16 / 10; border-radius: clamp(16px, 2.5vw, 24px); overflow: hidden; line-height: 0;
	}
	
	.dg-formula__card--stacked img {
		display: block !important; width: 100% !important; max-width: none !important; height: 100% !important; object-fit: cover !important;
	}
	
	.dg-formula__card--stacked .dg-formula__text {
		padding-top: clamp(20px, 3vw, 28px); color: var(--ink);
	}
	
	.dg-formula__name {
		margin: 0 0 16px; font-size: clamp(1.4rem, 2.2vw, 1.7rem); font-weight: 600; letter-spacing: -0.02em;
	}
	
	.dg-formula__list {
		margin: 0; padding: 0 0 0 18px; font-size: clamp(0.85rem, 1.2vw, 0.95rem); line-height: 1.55; letter-spacing: -0.02em;
	}
	
	.dg-formula__list li {
		margin-bottom: 6px; word-break: keep-all;
	}
	
	.dg-formula__list li:last-child {
		margin-bottom: 0;
	}
	
	@media (min-width: 768px) {
		.dg-formula__grid {
			flex-direction: row;
		}
		.dg-formula__col {
			flex: 1;
		}
	} .dg-power {
		--ink: #161413; background-color: #fff; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink);
		/* 이전 섹션들과의 간격을 위해 위아래 패딩 유지 */
		padding-block: clamp(40px, 8vw, 80px);
	}
.dg-power__inner {
		max-width: 1200px; margin: 0 auto;
		/* 타겟 이미지처럼 콘텐츠가 꽉 차 보이도록 좌우 패딩 최소화 */
