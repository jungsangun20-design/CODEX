		}
		.dg-enjoy__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	} .dg-intro {
		--ink: #161413; --soft: #6b6f6d; background-color: #fff; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(50px, 8vw, 100px);
	}
.dg-intro__inner {
		max-width: 1200px; margin: 0 auto; padding-inline: clamp(20px, 5vw, 64px); display: grid; grid-template-columns: 1fr; gap: clamp(32px, 5vw, 60px); align-items: center;
	}
	
	.dg-intro__text {
		display: flex; flex-direction: column;
	}
	
	.dg-intro__title {
		margin: 0 0 10px; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.04em;
	}
	
	.dg-intro__sub {
		margin: 0 0 clamp(20px, 4vw, 32px); font-family: "Georgia Pro", Georgia, "Times New Roman", serif;/* 영문 세리프(이탤릭) 폰트 적용 */
		font-style: italic; font-size: clamp(1.6rem, 3.5vw, 2.8rem); font-weight: 400; letter-spacing: -0.02em;
	}
	
	.dg-intro__desc {
		margin: 0; color: var(--soft); font-size: clamp(0.95rem, 1.2vw, 1.05rem); line-height: 1.65; word-break: keep-all;
	}
	
	.dg-intro__media {
		width: 100%; line-height: 0;
	}
	
	.dg-intro__media img {
		display: block; width: 100%; height: auto; border-radius: clamp(16px, 2.5vw, 24px); object-fit: cover;
	}
	
	@media (min-width: 768px) {
		.dg-intro__inner {
			grid-template-columns: 1fr 1fr;
		}
	} .dg-formula {
		--ink: #161413; --soft: #6b6f6d; background-color: #fff; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(50px, 8vw, 100px);
	}
