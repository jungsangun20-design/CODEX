	.dg-power__title {
		margin: 0 0 clamp(32px, 5vw, 56px); font-size: clamp(2.8rem, 5.5vw, 4.6rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.04em;
	}
	
	.dg-power__sub {
		margin: 0 0 16px; font-size: clamp(0.95rem, 1.4vw, 1.1rem); font-weight: 700; line-height: 1.4; word-break: keep-all;
