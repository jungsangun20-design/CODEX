		.dg-power__cell--logo {
			min-height: 0;
		}
	} .dg-beyond {
		--ink: #161413; --soft: #4a4d4b; background-color: #fff; font-family: "Pretendard Variable", Pretendard, -apple-system, "Helvetica Neue", sans-serif; color: var(--ink); padding-block: clamp(50px, 8vw, 100px);
	}
