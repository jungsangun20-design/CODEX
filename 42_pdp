	.dg-power__grid {
		display: grid; grid-template-columns: 1fr; gap: 0; background-color: #fff;
	}
	
	.dg-power__cell {
		display: flex; flex-direction: column; justify-content: center;
	}
	
	.dg-power__cell--img {
		aspect-ratio: 4 / 3; line-height: 0; overflow: hidden;
